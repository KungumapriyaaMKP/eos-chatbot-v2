model wallet_transactions {
  id                   Int                    @id @default(autoincrement())
  wallet_id            Int
  txn_type             wallet_txn_type_enum
  source               wallet_txn_source_enum
  amount               Decimal                @db.Decimal(12, 2)
  status               wallet_txn_status_enum @default(pending)
  processed_by_user_id Int?
  razorpay_order_id    String?                @unique(map: "idx_wallet_txn_razorpay_order", where: raw("(razorpay_order_id IS NOT NULL)")) @db.VarChar(100)
  razorpay_payment_id  String?                @db.VarChar(100)
  razorpay_signature   String?                @db.VarChar(255)
  remarks              String?                @db.VarChar(255)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  outlet_id            Int?
  users                users?                 @relation(fields: [processed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "wallet_transactions_collected_by_user_id_fkey")
  wallet_outlets       wallet_outlets?        @relation(fields: [outlet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_wallets      student_wallets        @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([outlet_id, created_at], map: "idx_wallet_txn_outlet")
  @@index([wallet_id, created_at], map: "idx_wallet_txn_wallet")
}

