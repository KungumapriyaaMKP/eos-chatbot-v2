generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model academic_calendars {
  id                 Int               @id @default(autoincrement())
  batch_id           Int
  semester           Int               @db.SmallInt
  start_date         DateTime          @db.Date
  end_date           DateTime          @db.Date
  created_by_user_id Int?
  batches            batches           @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?            @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calendar_events    calendar_events[]

  @@unique([batch_id, semester])
}

model announcements {
  id                         Int                          @id @default(autoincrement())
  posted_by_user_id          Int
  title                      String                       @db.VarChar(150)
  content                    String
  target_audience            target_audience_enum
  batch_id                   Int?
  department_id              Int?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  announcement_class_mapping announcement_class_mapping[]
  batches                    batches?                     @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments                departments?                 @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                      users                        @relation(fields: [posted_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([target_audience, batch_id, department_id], map: "idx_announcements_target")
}

model appraisal_criteria {
  id                  Int                 @id @default(autoincrement())
  division_id         Int
  criteria_name       String              @db.VarChar(150)
  max_score           Decimal             @db.Decimal(6, 2)
  academic_year       String              @db.VarChar(20)
  appraisal_divisions appraisal_divisions @relation(fields: [division_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appraisal_entries   appraisal_entries[]
}

model appraisal_divisions {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(100)
  appraisal_criteria appraisal_criteria[]
}

model appraisal_entries {
  id                   Int                @id @default(autoincrement())
  appraisal_request_id Int
  criteria_id          Int
  description          String?
  score                Decimal?           @db.Decimal(6, 2)
  appraisal_requests   appraisal_requests @relation(fields: [appraisal_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appraisal_criteria   appraisal_criteria @relation(fields: [criteria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model appraisal_requests {
  id                                                     Int                   @id @default(autoincrement())
  faculty_id                                             Int
  academic_year                                          String                @db.VarChar(20)
  status                                                 appraisal_status_enum @default(submitted)
  hod_reviewed_by                                        Int?
  hod_reviewed_at                                        DateTime?             @db.Timestamptz(6)
  management_approved_by                                 Int?
  management_approved_at                                 DateTime?             @db.Timestamptz(6)
  created_at                                             DateTime              @default(now()) @db.Timestamptz(6)
  appraisal_entries                                      appraisal_entries[]
  faculty                                                faculty               @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appraisal_requests_hod_reviewed_byTousers        users?                @relation("appraisal_requests_hod_reviewed_byTousers", fields: [hod_reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_appraisal_requests_management_approved_byTousers users?                @relation("appraisal_requests_management_approved_byTousers", fields: [management_approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignments {
  id                        Int                         @id @default(autoincrement())
  class_id                  Int
  subject_id                Int
  faculty_id                Int
  academic_year             String                      @db.VarChar(20)
  semester                  Int                         @db.SmallInt
  sequence_no               Int                         @db.SmallInt
  title                     String?                     @db.VarChar(200)
  classes                   classes                     @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty                   faculty                     @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects                  subjects                    @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_assignment_status student_assignment_status[]

  @@unique([class_id, subject_id, academic_year, semester, sequence_no])
  @@index([class_id, subject_id, academic_year, semester], map: "idx_assignments_class_subject")
}

model attendance_records {
  id                   Int                    @id @default(autoincrement())
  student_id           Int
  class_id             Int
  subject_id           Int?
  attendance_date      DateTime               @db.Date
  status               attendance_status_enum
  marked_by_faculty_id Int
  classes              classes                @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty              faculty                @relation(fields: [marked_by_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects             subjects?              @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students             students               @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_student")

  @@unique([student_id, class_id, subject_id, attendance_date])
  @@index([class_id, attendance_date], map: "idx_attendance_class_date")
  @@index([student_id, attendance_date], map: "idx_attendance_student_date")
}

model batches {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(50)
  start_year         Int                  @db.SmallInt
  end_year           Int                  @db.SmallInt
  academic_calendars academic_calendars[]
  alumni_batches     alumni_batches?
  announcements      announcements[]
  classes            classes[]
  exams              exams[]
  feedback_forms     feedback_forms[]
  project_teams      project_teams[]
  students           students[]
}

model bonafide_reasons {
  id                Int                 @id @default(autoincrement())
  reason_text       String              @unique @db.VarChar(255)
  bonafide_requests bonafide_requests[]
}

model bonafide_requests {
  id               Int                  @id @default(autoincrement())
  student_id       Int
  reason_id        Int
  status           bonafide_status_enum @default(pending)
  requested_at     DateTime             @default(now()) @db.Timestamptz(6)
  issued_at        DateTime?            @db.Timestamptz(6)
  file_url         String?              @db.VarChar(500)
  bonafide_reasons bonafide_reasons     @relation(fields: [reason_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students         students             @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model book_borrow_records {
  id                               Int                @id @default(autoincrement())
  book_id                          Int
  borrower_type                    borrower_type_enum
  student_id                       Int?
  faculty_id                       Int?
  borrowed_date                    DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date                         DateTime           @db.Date
  returned_date                    DateTime?          @db.Date
  status                           borrow_status_enum @default(borrowed)
  renewal_count                    Int                @default(0) @db.SmallInt
  last_renewed_at                  DateTime?          @db.Timestamptz(6)
  fine_paid                        Boolean            @default(false)
  fine_paid_amount                 Decimal?           @db.Decimal(10, 2)
  fine_paid_at                     DateTime?          @db.Timestamptz(6)
  fine_collected_by_user_id        Int?
  damage_lost_charge_amount        Decimal?           @db.Decimal(10, 2)
  damage_lost_declared_at          DateTime?          @db.Timestamptz(6)
  damage_lost_settled              Boolean            @default(false)
  damage_lost_settled_at           DateTime?          @db.Timestamptz(6)
  damage_lost_collected_by_user_id Int?
  replacement_indent_id            Int?               @unique
  books                            books              @relation(fields: [book_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_indents                 purchase_indents?  @relation(fields: [replacement_indent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty                          faculty?           @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                         students?          @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fine_collected_by                users?             @relation("BorrowRecordFineCollectedBy", fields: [fine_collected_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  damage_lost_collected_by         users?             @relation("BorrowRecordDamageLostCollectedBy", fields: [damage_lost_collected_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_book_borrow_status")
}

model book_categories {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(150)
  books       books[]
  e_resources e_resources[]
}

model books {
  id                  Int                   @id @default(autoincrement())
  qr_code             String                @unique @db.VarChar(100)
  title               String                @db.VarChar(255)
  author              String?               @db.VarChar(255)
  isbn                String?               @db.VarChar(30)
  publisher           String?               @db.VarChar(255)
  edition             String?               @db.VarChar(50)
  category_id         Int
  department_id       Int?
  rack_id             Int?
  total_copies        Int                   @default(1)
  available_copies    Int                   @default(1)
  price_per_copy      Decimal?              @db.Decimal(10, 2)
  vendor_fund         String?               @db.VarChar(255)
  book_borrow_records book_borrow_records[]
  book_categories     book_categories       @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments         departments?          @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  library_racks       library_racks?        @relation(fields: [rack_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model library_racks {
  id            Int      @id @default(autoincrement())
  rack_code     String   @unique @db.VarChar(30)
  shelves       Int      @default(1)
  subject_range String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  books         books[]
}

/// Single-row library-wide configuration (borrowing limits, fine rates,
/// barcode/RFID format, counter hours). No generic settings table exists
/// elsewhere in this codebase to reuse, and library needs exactly one
/// config object per install, so this is its own small dedicated model
/// rather than a key-value store.
model library_settings {
  id                       Int      @id @default(autoincrement())
  books_per_student        Int      @default(3)
  default_borrowing_days   Int      @default(14)
  max_renewals             Int      @default(2)
  renewal_extension_days   Int      @default(14)
  fine_per_day             Decimal  @default(5) @db.Decimal(10, 2)
  lost_book_processing_fee Decimal  @default(100) @db.Decimal(10, 2)
  damaged_book_charge_rate Decimal  @default(0.40) @db.Decimal(4, 2)
  grace_period_days        Int      @default(1)
  block_issue_above_fine   Decimal  @default(200) @db.Decimal(10, 2)
  barcode_format           String?  @db.VarChar(30)
  spine_label_prefix       String?  @db.VarChar(20)
  counter_opens_at         String?  @db.VarChar(10)
  counter_closes_at        String?  @db.VarChar(10)
  updated_at               DateTime @updatedAt
}

model bus_live_locations {
  id         Int      @id @default(autoincrement())
  bus_id     Int
  latitude   Decimal  @db.Decimal(10, 6)
  longitude  Decimal  @db.Decimal(10, 6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  buses      buses    @relation(fields: [bus_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model buses {
  id                 Int                  @id @default(autoincrement())
  route_id           Int?
  vehicle_number     String               @unique @db.VarChar(30)
  driver_name        String?              @db.VarChar(150)
  gps_device_id      String?              @db.VarChar(100)
  bus_no             String               @unique
  bus_live_locations bus_live_locations[]
  transport_routes   transport_routes?    @relation(fields: [route_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model calendar_events {
  id                   Int                      @id(map: "calendar_holidays_pkey") @default(autoincrement())
  academic_calendar_id Int
  event_date           DateTime                 @db.Date
  description          String?                  @db.VarChar(255)
  event_type           calendar_event_type_enum @default(holiday)
  title                String                   @db.VarChar(200)
  start_time           DateTime?                @db.Time(6)
  end_time             DateTime?                @db.Time(6)
  created_by_user_id   Int?
  users                users?                   @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academic_calendars   academic_calendars       @relation(fields: [academic_calendar_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_holidays_academic_calendar_id_fkey")

  @@index([academic_calendar_id, event_date], map: "idx_calendar_events_calendar_date")
  @@index([event_type], map: "idx_calendar_events_type")
}

model certificate_types {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique @db.VarChar(150)
  student_certificates student_certificates[]
}

model class_mentors {
  id                  Int     @id @default(autoincrement())
  class_id            Int
  faculty_id          Int
  academic_year       String  @db.VarChar(20)
  assigned_by_user_id Int?
  users               users?  @relation(fields: [assigned_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classes             classes @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty             faculty @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([class_id, academic_year])
}

model class_subjects {
  id         Int      @id @default(autoincrement())
  class_id   Int
  subject_id Int
  semester   Int      @db.SmallInt
  classes    classes  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects   subjects @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([class_id, subject_id, semester])
}

model classes {
  id                            Int                             @id @default(autoincrement())
  batch_id                      Int
  department_id                 Int
  course_id                     Int
  section                       String                          @db.VarChar(10)
  current_semester              Int?                            @db.SmallInt
  announcement_class_mapping    announcement_class_mapping[]
  assignments                   assignments[]
  attendance_records            attendance_records[]
  class_mentors                 class_mentors[]
  class_subjects                class_subjects[]
  batches                       batches                         @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses                       courses                         @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments                   departments                     @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_subject_mapping          exam_subject_mapping[]
  faculty_subject_class_mapping faculty_subject_class_mapping[]
  feedback_forms                feedback_forms[]
  lesson_plans                  lesson_plans[]
  lms_notes                     lms_notes[]
  project_teams                 project_teams[]
  students                      students[]
  timetable_slots               timetable_slots[]

  @@unique([batch_id, course_id, section])
}

model companies {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(200)
  profile_info     String?
  placement_drives placement_drives[]
}

model courses {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(150)
  code           String      @unique @db.VarChar(30)
  department_id  Int
  duration_years Int         @default(4) @db.SmallInt
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  classes        classes[]
  departments    departments @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students       students[]
}

model demand_categories {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique @db.VarChar(100)
  fee_structure_items fee_structure_items[]
}

model departments {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @db.VarChar(150)
  code                     String                     @unique @db.VarChar(20)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  announcements            announcements[]
  books                    books[]
  classes                  classes[]
  courses                  courses[]
  department_achievements  department_achievements[]
  faculty                  faculty[]
  non_teaching_staff       non_teaching_staff[]
  od_request_hod_approvals od_request_hod_approvals[]
  project_teams            project_teams[]
  purchase_indents         purchase_indents[]
  service_indents          service_indents[]
  subjects                 subjects[]
}

model e_resources {
  id                  Int              @id @default(autoincrement())
  title               String           @db.VarChar(255)
  url                 String           @db.VarChar(500)
  category_id         Int?
  format              String?          @db.VarChar(20)
  file_size_bytes     Int?
  pages               Int?
  license_type        String?          @db.VarChar(50)
  concurrent_seats    Int?
  publish_state       String           @default("draft") @db.VarChar(20)
  uploaded_by_user_id Int?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  book_categories     book_categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?           @relation(fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model education_loan_dd {
  id                            Int                        @id @default(autoincrement())
  student_fee_demand_mapping_id Int
  dd_reference_number           String                     @unique @db.VarChar(50)
  bank_name                     String                     @db.VarChar(150)
  amount                        Decimal                    @db.Decimal(12, 2)
  status                        dd_status_enum             @default(received)
  acknowledgement_receipt_no    String?                    @db.VarChar(50)
  received_by_user_id           Int?
  created_at                    DateTime                   @default(now()) @db.Timestamptz(6)
  users                         users?                     @relation(fields: [received_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_fee_demand_mapping    student_fee_demand_mapping @relation(fields: [student_fee_demand_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model exam_marks {
  id                      Int                    @id @default(autoincrement())
  exam_subject_mapping_id Int
  student_id              Int
  marks_obtained          Decimal?               @db.Decimal(6, 2)
  max_marks               Decimal                @db.Decimal(6, 2)
  entered_by_faculty_id   Int?
  entered_at              DateTime               @default(now()) @db.Timestamptz(6)
  faculty                 faculty?               @relation(fields: [entered_by_faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_subject_mapping    exam_subject_mapping   @relation(fields: [exam_subject_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                students               @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revaluation_requests    revaluation_requests[]

  @@unique([exam_subject_mapping_id, student_id])
  @@index([exam_subject_mapping_id], map: "idx_exam_marks_mapping")
  @@index([student_id], map: "idx_exam_marks_student")
}

model exam_subject_mapping {
  id             Int             @id @default(autoincrement())
  exam_id        Int
  class_id       Int
  subject_id     Int
  // is_published/published_at/is_elective: present in the live database but
  // missing from EOS-backend's checked-in schema.prisma (confirmed via
  // information_schema — genuine schema drift, not introduced here). Added
  // to this LOCAL copy only, same as the e_resources relation patch above,
  // so src/services/exam-schedule.service.ts can filter on real publish
  // status instead of the now-removed (and never-actually-existing)
  // exam_timetable.is_published. See README "One schema patch".
  is_published   Boolean         @default(false)
  published_at   DateTime?       @db.Timestamptz(6)
  is_elective    Boolean         @default(false)
  exam_marks     exam_marks[]
  classes        classes         @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exams          exams           @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects       subjects        @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_timetable exam_timetable?

  @@unique([exam_id, class_id, subject_id])
}

model exam_timetable {
  id                      Int                  @id @default(autoincrement())
  exam_subject_mapping_id Int                  @unique
  exam_date               DateTime             @db.Date
  start_time              DateTime             @db.Time(6)
  end_time                DateTime             @db.Time(6)
  is_published            Boolean              @default(false)
  exam_subject_mapping    exam_subject_mapping @relation(fields: [exam_subject_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model exam_types {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  exams exams[]
}

model exams {
  id                               Int                                @id @default(autoincrement())
  exam_type_id                     Int
  batch_id                         Int
  academic_year                    String                             @db.VarChar(20)
  semester                         Int                                @db.SmallInt
  status                           exam_status_enum                   @default(created)
  created_by_user_id               Int?
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  exam_subject_mapping             exam_subject_mapping[]
  batches                          batches                            @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                            users?                             @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_types                       exam_types                         @relation(fields: [exam_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hall_plans                       hall_plans[]
  hall_ticket_clearance_exceptions hall_ticket_clearance_exceptions[]
  hall_tickets                     hall_tickets[]
  invigilation_duties              invigilation_duties[]
  marksheets                       marksheets[]
  result_publications              result_publications[]
}

model expense_categories {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(100)
  expenses expenses[]
}

model expenses {
  id                  Int                @id @default(autoincrement())
  category_id         Int
  description         String?            @db.VarChar(255)
  amount              Decimal            @db.Decimal(12, 2)
  expense_date        DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  recorded_by_user_id Int?
  expense_categories  expense_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?             @relation(fields: [recorded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category_id, expense_date], map: "idx_expenses_category_date")
}

model faculty {
  id                            Int                             @id @default(autoincrement())
  user_id                       Int                             @unique
  first_name                    String                          @db.VarChar(100)
  last_name                     String                          @db.VarChar(100)
  designation                   String                          @db.VarChar(100)
  department_id                 Int
  date_of_joining               DateTime?                       @db.Date
  status                        user_status_enum                @default(active)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  appraisal_requests            appraisal_requests[]
  assignments                   assignments[]
  attendance_records            attendance_records[]
  book_borrow_records           book_borrow_records[]
  class_mentors                 class_mentors[]
  exam_marks                    exam_marks[]
  departments                   departments                     @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
