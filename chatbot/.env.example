# ─────────────────────────────────────────────
# EOS Chatbot — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# SAME PostgreSQL database as the EOS-backend (Supabase or local).
# The chatbot only ever runs read queries against this DB — never migrations,
# never writes. Point it at the exact DATABASE_URL used by EOS-backend/.env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Chatbot JWT (TEMPORARY — separate from the backend's own JWT_SECRET) ──
# This entire auth/ module is a stand-in for testing the chatbot in
# isolation. When the real ERP frontend integrates and forwards its own
# session/JWT instead, delete src/auth/ and swap the verifyJwt middleware
# for one that validates the ERP's token — nothing else in the chatbot
# depends on how the token was issued, only on the {sub, name, role} shape.
CHATBOT_JWT_SECRET="replace_with_a_long_random_secret_key"
CHATBOT_JWT_EXPIRES_IN="8h"

# Intent match confidence threshold (0-1). Below this, the bot asks the user
# to rephrase instead of guessing an intent. Tune after reviewing real traffic.
INTENT_CONFIDENCE_THRESHOLD=0.55

# Ambiguity-margin guard (0-1). DEFAULT 0 (disabled) — deliberately, based on
# real measurement: every positive value tested REDUCED overall accuracy on
# the real held-out question set. See src/config/env.ts for the full story
# before changing this.
INTENT_AMBIGUITY_MARGIN=0

# ── Local LLM (Ollama) — used for confidence-gated intent reranking and
# reply paraphrasing. Both are optional; the chatbot works correctly
# without Ollama running, just with less polished replies. ──
# Setup: install Ollama (https://ollama.com), then `ollama pull llama3.2:3b`.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Toggle the LLM reranker. Only actually invoked when SBERT's own confidence
# is below INTENT_LLM_RERANK_CEILING — see src/config/env.ts.
INTENT_LLM_RERANK_ENABLED=true
INTENT_LLM_RERANK_CEILING=0.72
INTENT_LLM_RERANK_TOP_K=4

# Toggle rewording an already-correct reply for more natural phrasing.
# Every rewrite is fact-verified before use; falls back to the original on
# any doubt. See src/reply/paraphraser.ts.
REPLY_PARAPHRASE_ENABLED=true

# CORS — comma-separated list of allowed origins (or * for dev)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
