{
  "name": "eos-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "SBERT-based ERP chatbot backend for EOS. Reuses the existing EOS-backend database, Prisma models and business rules — fully offline intent detection, plus a local Ollama LLM for confidence-gated reranking and reply paraphrasing (never fact-generation). 3 chatbot-owned tables back a query-logging/learning pipeline.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "train:parse": "tsx src/training/parse-dataset.ts",
    "train:embed": "tsx src/training/build-embeddings.ts",
    "train": "npm run train:parse && npm run train:embed",
    "typecheck": "tsc --noEmit",
    "learning:review": "tsx scripts/review-training-candidates.ts",
    "learning:approve": "tsx scripts/approve-training-candidates.ts",
    "learning:merge": "tsx scripts/merge-approved-training-examples.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "jszip": "^3.10.1",
    "pdfkit": "^0.19.1",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
