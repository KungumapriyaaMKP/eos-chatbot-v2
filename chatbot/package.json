{
  "name": "eos-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "SBERT-based ERP chatbot backend for EOS. Reuses the existing EOS-backend database, Prisma models and business rules — no new tables, no LLM, fully offline intent detection.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "train:parse": "tsx src/training/parse-dataset.ts",
    "train:embed": "tsx src/training/build-embeddings.ts",
    "train": "npm run train:parse && npm run train:embed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "jszip": "^3.10.1",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
